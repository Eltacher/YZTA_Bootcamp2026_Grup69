# Bu dosyayı ".env" adıyla kopyalayıp kendi değerlerinizi girin.
# .env dosyası .gitignore kapsamındadır, asla commit edilmez.

# Wiro AI proje anahtarları (wiro.ai panelinden alınır).
# Sunucu tarafı isteklerde yalnızca AI_API_KEY kullanılır; AI_API_SECRET,
# ileride imzalı (HMAC) kimlik doğrulamaya geçilirse gerekecek.
AI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kullanılacak model, "owner/model" biçiminde. Kod, seçilen modelin
# desteklediği parametreleri otomatik keşfeder; model değiştirmek için bu
# satırı düzenleyip sunucuyu yeniden başlatmak YETERLİDİR.
# Mevcut LLM modellerine göz atın: https://wiro.ai/models?category=llm-chat
#
# DİKKAT: Belge analizi uç noktasının GÖRSEL (JPEG/PNG ve JPEG'e dönüştürülen
# HEIC/HEIF) girdileri işleyebilmesi
# için modelin multimodal olması, yani "inputImage" parametresini desteklemesi
# gerekir. Görsel girdi desteklemeyen bir modelde /api/v1/document/analyze
# görsel yüklemelerine 503 döner; PDF yüklemeleri (metin çıkarma yoluyla)
# her modelde çalışmaya devam eder.
AI_MODEL=openai/gpt-5-6-luna

# Sağlayıcı API'sinin taban adresi.
AI_BASE_URL=https://api.wiro.ai/v1
