# Bu dosyayı ".env" adıyla kopyalayıp kendi değerlerinizi girin.
# .env dosyası .gitignore kapsamındadır, asla commit edilmez.

# Yapay zeka sağlayıcısının API anahtarı.
# Şu an Hugging Face kullanıyoruz: https://huggingface.co/settings/tokens
# Fine-grained token oluşturuyorsanız "Make calls to Inference Providers" iznini açın.
AI_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kullanılacak modelin kimliği. Model adları bilinçli olarak kodda geçmez;
# model değişikliği yalnızca bu satırda yapılır.
# Daha küçük/ekonomik alternatif: Qwen/Qwen3-4B-Instruct-2507
AI_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Sağlayıcı seçimi: "auto" modeli yayınlayan ilk uygun sağlayıcıya yönlendirir.
AI_PROVIDER=auto
