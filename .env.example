# Bu dosyayı ".env" adıyla kopyalayıp kendi değerlerinizi girin.
# .env dosyası .gitignore kapsamındadır, asla commit edilmez.

# OpenAI uyumlu sağlayıcının API anahtarı (ekip kararı: Wiro AI panelinden alınır).
AI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kullanılacak modelin kimliği. Model adları bilinçli olarak kodda geçmez;
# model değişikliği yalnızca bu satırda yapılır.
AI_MODEL=google/gemini-omni-flash

# OpenAI uyumlu API'nin taban adresi. Sağlayıcı değişirse yalnızca bu satır güncellenir.
AI_BASE_URL=https://api.wiro.ai/v1
